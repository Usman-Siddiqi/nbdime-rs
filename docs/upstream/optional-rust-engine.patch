@@ -0,0 +1,336 @@
+# Copyright (c) Jupyter Development Team.
+# Distributed under the terms of the Modified BSD License.
+
+import logging
+import threading
+import time
+from importlib import import_module
+from pathlib import Path
+from types import SimpleNamespace
+
+import nbformat
+import pytest
+
+from nbdime import _accel, diff_notebooks, merge_notebooks
+from nbdime.diff_format import DiffEntry
+from nbdime.diffing import notebooks
+from nbdime.merging.decisions import MergeDecision
+
+
+class EngineError(Exception):
+    pass
+
+
+@pytest.fixture
+def engine(monkeypatch):
+    engine = SimpleNamespace(
+        NBDIME_COMPAT=_accel.__version__,
+        EngineError=EngineError,
+        calls=[],
+    )
+
+    def diff(a, b, *, ignores):
+        engine.calls.append(("diff", ignores))
+        return [{"op": "add", "key": "accelerated", "value": {"nested": 1}}]
+
+    def merge(base, local, remote, args, *, ignores):
+        engine.calls.append(("merge", ignores, args))
+        return [{
+            "common_path": [],
+            "conflict": False,
+            "action": "local",
+            "local_diff": diff(base, local, ignores=ignores),
+            "remote_diff": None,
+        }]
+
+    engine.diff_notebooks = diff
+    engine.decide_notebook_merge = merge
+    monkeypatch.setattr(_accel, "_engine", engine)
+    monkeypatch.setenv("NBDIME_ACCEL", "1")
+    notebooks.reset_notebook_differ()
+    yield engine
+    notebooks.reset_notebook_differ()
+
+
+def test_accelerated_result_types(engine):
+    nb = nbformat.v4.new_notebook()
+    result = diff_notebooks(nb, nb)
+    assert isinstance(result[0], DiffEntry)
+    assert isinstance(result[0].value, nbformat.NotebookNode)
+
+    merged, decisions = merge_notebooks(nb, nb, nb)
+    assert isinstance(decisions[0], MergeDecision)
+    assert isinstance(decisions[0].common_path, tuple)
+    assert isinstance(decisions[0].local_diff[0], DiffEntry)
+    assert merged.accelerated.nested == 1
+    assert ("merge", {}, None) in engine.calls
+
+
+@pytest.mark.parametrize("reason", ["disabled", "missing", "incompatible", "conversion"])
+def test_pure_python_fallback(engine, monkeypatch, caplog, reason):
+    if reason == "disabled":
+        monkeypatch.setenv("NBDIME_ACCEL", "0")
+    elif reason == "missing":
+        monkeypatch.setattr(_accel, "_engine", None)
+    elif reason == "incompatible":
+        engine.NBDIME_COMPAT = "incompatible"
+    else:
+        def fail(*args, **kwargs):
+            raise EngineError("fallback")
+        engine.diff_notebooks = fail
+        engine.decide_notebook_merge = fail
+
+    nb = nbformat.v4.new_notebook()
+    with caplog.at_level(logging.DEBUG, logger="nbdime"):
+        assert diff_notebooks(nb, nb) == []
+        assert merge_notebooks(nb, nb, nb) == (nb, [])
+    assert not engine.calls
+    assert ("fallback" in caplog.text) == (reason == "conversion")
+
+
+@pytest.mark.parametrize("reason", ["missing", "incompatible", "conversion"])
+def test_force_raises_instead_of_falling_back(engine, monkeypatch, reason):
+    monkeypatch.setenv("NBDIME_ACCEL", "force")
+    if reason == "missing":
+        monkeypatch.setattr(_accel, "_engine", None)
+    elif reason == "incompatible":
+        engine.NBDIME_COMPAT = "incompatible"
+    else:
+        def fail(*args, **kwargs):
+            raise EngineError("fallback")
+        engine.diff_notebooks = fail
+        engine.decide_notebook_merge = fail
+
+    nb = nbformat.v4.new_notebook()
+    with pytest.raises(EngineError if reason == "conversion" else RuntimeError):
+        diff_notebooks(nb, nb)
+    with pytest.raises(EngineError if reason == "conversion" else RuntimeError):
+        merge_notebooks(nb, nb, nb)
+
+
+def test_other_engine_errors_are_not_swallowed(engine):
+    def fail(*args, **kwargs):
+        raise TypeError("bug")
+
+    engine.diff_notebooks = fail
+    nb = nbformat.v4.new_notebook()
+    with pytest.raises(TypeError):
+        diff_notebooks(nb, nb)
+
+
+def test_force_uses_python_for_unsupported_configuration(engine, monkeypatch):
+    monkeypatch.setenv("NBDIME_ACCEL", "force")
+    monkeypatch.setitem(notebooks.notebook_predicates, "/cells", [lambda a, b: False])
+    nb = {"cells": []}
+    assert diff_notebooks(nb, nb) == []
+    assert not engine.calls
+
+
+def test_engine_is_loaded_once_across_threads(monkeypatch):
+    imports = []
+
+    def slow_import(name):
+        imports.append(name)
+        time.sleep(0.05)
+        return None
+
+    monkeypatch.setattr(_accel, "_engine", _accel._UNLOADED)
+    monkeypatch.setattr(_accel, "import_module", slow_import)
+    monkeypatch.setenv("NBDIME_ACCEL", "1")
+    threads = [threading.Thread(target=_accel.enabled) for _ in range(8)]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join()
+    assert imports == ["nbdime_rs"]
+
+
+def test_supported_ignores_are_tracked(engine):
+    keys = ["first"]
+    notebooks.set_notebook_diff_ignores({"/metadata": keys})
+    notebooks.set_notebook_diff_ignores({"/metadata": ("second",)})
+    keys.append("third")
+    diff_notebooks({}, {})
+    assert engine.calls[-1] == ("diff", {"/metadata": ["first", "third", "second"]})
+
+    notebooks.set_notebook_diff_targets(metadata=False)
+    diff_notebooks({}, {})
+    assert engine.calls[-1][1]["/metadata"] is True
+
+    notebooks.reset_notebook_differ()
+    diff_notebooks({}, {})
+    assert engine.calls[-1] == ("diff", {})
+
+
+def test_custom_differ_keeps_python_configuration(engine, monkeypatch):
+    calls = []
+
+    def custom(a, b, **kwargs):
+        calls.append((a, b))
+        return []
+
+    monkeypatch.setitem(notebooks.notebook_differs, "/metadata", custom)
+    a, b = {"metadata": {"a": 1}}, {"metadata": {"a": 2}}
+    assert diff_notebooks(a, b) == []
+    assert calls == [(a["metadata"], b["metadata"])]
+    assert not engine.calls
+
+
+def test_custom_predicate_disables_acceleration(engine, monkeypatch):
+    a = {"cells": []}
+    monkeypatch.setitem(notebooks.notebook_predicates, "/cells", [lambda a, b: False])
+    assert diff_notebooks(a, a) == []
+    assert not engine.calls
+
+
+def test_disabled_does_not_import_engine(monkeypatch):
+    def unexpected(*args, **kwargs):
+        pytest.fail("the disabled engine was imported")
+
+    monkeypatch.setenv("NBDIME_ACCEL", "0")
+    monkeypatch.setattr(_accel, "_engine", _accel._UNLOADED)
+    monkeypatch.setattr(_accel, "import_module", unexpected)
+    assert diff_notebooks({}, {}) == []
+
+
+def test_mixed_notebook_payloads_keep_their_python_types(engine):
+    a = nbformat.v4.new_notebook()
+    b = nbformat.v4.new_notebook()
+    b.metadata["extra"] = [{"nested": 1}]
+    result = diff_notebooks(a, b)
+    assert type(result[0].diff[0].value[0]) is dict
+    assert not engine.calls
+
+
+def test_custom_default_differ_with_value_equality(engine, monkeypatch):
+    class Differ:
+        def __eq__(self, other):
+            return True
+
+        def __call__(self, *args, **kwargs):
+            return []
+
+    monkeypatch.setitem(notebooks.notebook_differs.default_values, "/cells/*/source", Differ())
+    a = nbformat.v4.new_notebook(cells=[nbformat.v4.new_code_cell("one", id="id")])
+    b = nbformat.v4.new_notebook(cells=[nbformat.v4.new_code_cell("two", id="id")])
+    assert diff_notebooks(a, b) == []
+    assert not engine.calls
+
+
+def test_custom_object_diffs_keep_notebook_nodes(engine):
+    def custom_merge(*args, **kwargs):
+        return [{"custom_diff": [{"op": "addrange", "key": 0, "valuelist": [{"source": "plain"}]}]}]
+
+    engine.decide_notebook_merge = custom_merge
+    base = nbformat.v4.new_notebook()
+    local = nbformat.v4.new_notebook(cells=[nbformat.v4.new_code_cell("print('left')", id="lc")])
+    remote = nbformat.v4.new_notebook(cells=[nbformat.v4.new_markdown_cell("different", id="rc")])
+    _, decisions = merge_notebooks(base, local, remote)
+    assert all(isinstance(cell, nbformat.NotebookNode)
+               for cell in decisions[0].custom_diff[0].valuelist)
+
+
+def test_similar_insert_is_a_diff(engine):
+    def merge(*args, **kwargs):
+        return [{
+            "common_path": [],
+            "conflict": False,
+            "action": "local",
