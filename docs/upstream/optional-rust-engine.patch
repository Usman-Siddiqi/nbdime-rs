new file mode 100644
index 0000000..4c6da12
--- /dev/null
+++ b/nbdime/_accel.py
@@ -0,0 +1,294 @@
+# Copyright (c) Jupyter Development Team.
+# Distributed under the terms of the Modified BSD License.
+
+"""Optional notebook diff and merge acceleration."""
+
+from argparse import Namespace
+from importlib import import_module
+from math import isnan
+import os
+import threading
+from types import SimpleNamespace
+
+from nbformat import NotebookNode, from_dict
+
+from ._version import __version__
+from .diff_format import DiffEntry
+from .log import logger
+
+_UNLOADED = object()
+_engine = _UNLOADED
+_load_lock = threading.Lock()
+
+
+def _load():
+    """Import the engine once, even when several threads ask for it at the same time."""
+    global _engine
+    with _load_lock:
+        if _engine is _UNLOADED:
+            try:
+                _engine = import_module("nbdime_rs")
+            except ImportError as e:
+                logger.debug("nbdime_rs could not be imported: %s", e)
+                _engine = None
+
+
+def enabled():
+    """Whether the engine can be used.
+
+    ``NBDIME_ACCEL`` selects the mode: ``0`` never uses the engine and never imports it, ``force``
+    raises instead of falling back to Python when the engine is missing, incompatible or fails,
+    and any other value (the default) uses the engine when a compatible one imports.
+    """
+    mode = os.environ.get("NBDIME_ACCEL", "1")
+    if mode == "0":
+        return False
+    if _engine is _UNLOADED:
+        _load()
+    error = getattr(_engine, "EngineError", None)
+    usable = (
+        getattr(_engine, "NBDIME_COMPAT", None) == __version__
+        and isinstance(error, type)
+        and issubclass(error, Exception)
+        and callable(getattr(_engine, "diff_notebooks", None))
+        and callable(getattr(_engine, "decide_notebook_merge", None))
+    )
+    if not usable and mode == "force":
+        raise RuntimeError(
+            "NBDIME_ACCEL=force is set, but no compatible nbdime_rs extension "
+            "for nbdime %s is available" % __version__
+        )
+    return usable
+
+
+class NotebookOptions:
+    """Track which notebook differ changes can be described to the engine."""
+
+    def __init__(self, config, default_differ, default_predicate):
+        self._config = config
+        self._differs = config.differs
+        self._predicates = config.predicates
+        self._atomic_paths = dict(config._atomic_paths)
+        self._differ_factory = self._differs.default_factory
+        self._predicate_factory = self._predicates.default_factory
+        self._default_differ = default_differ
+        self._default_predicate = (default_predicate,)
+        self._differ_defaults = dict(self._differs.default_values)
+        self._predicate_defaults = {
+            path: tuple(predicates)
+            for path, predicates in self._predicates.default_values.items()
+        }
+        self.reset()
+
+    def reset(self):
+        self._overrides = {}
+
+    def matches(self, config):
+        if (
+            config is not self._config
+            or config.differs is not self._differs
+            or config.predicates is not self._predicates
+            or config._atomic_paths != self._atomic_paths
+            or self._differs.default_factory is not self._differ_factory
+            or self._predicates.default_factory is not self._predicate_factory
+        ):
+            return False
+        differ_defaults = self._differs.default_values
+        if (
+            differ_defaults.keys() != self._differ_defaults.keys()
+            or any(
+                differ is not self._differ_defaults[path]
+                for path, differ in differ_defaults.items()
+            )
+        ):
+            return False
+        predicate_defaults = self._predicates.default_values
+        if (
+            predicate_defaults.keys() != self._predicate_defaults.keys()
+            or any(
+                not self._same_predicates(predicates, self._predicate_defaults[path])
+                for path, predicates in predicate_defaults.items()
+            )
+        ):
+            return False
+        for path, predicates in self._predicates.items():
+            default = self._predicate_defaults.get(path, self._default_predicate)
+            if not self._same_predicates(predicates, default):
+                return False
+        for path, (differ, _) in self._overrides.items():
+            if self._differs.get(path) is not differ:
+                return False
+        for path, differ in self._differs.items():
+            if path not in self._overrides:
+                default = self._differ_defaults.get(path, self._default_differ)
+                if differ is not default:
+                    return False
+        return True
+
+    @staticmethod
+    def _same_predicates(predicates, expected):
+        return (
+            type(predicates) in (list, tuple)
+            and len(predicates) == len(expected)
+            and all(a is b for a, b in zip(predicates, expected))
+        )
+
+    def record(self, path, subkeys):
+        if subkeys is False:
+            self._overrides.pop(path, None)
+            return
+        previous = self._overrides.get(path, (None, ()))[1]
+        groups = True if subkeys is True or previous is True else previous + (subkeys,)
+        self._overrides[path] = self._differs[path], groups
+
+    def ignores(self, config):
+        if not self.matches(config):
+            return None
+        rules = {}
+        for path, (_, groups) in self._overrides.items():
+            if type(path) is not str:
+                return None
+            if groups is True:
+                rules[path] = True
+                continue
+            keys = []
+            for group in groups:
+                if (
+                    type(group) not in (list, tuple, set)
+                    or any(type(key) is not str for key in group)
+                ):
+                    return None
+                keys.extend(group)
+            rules[path] = keys
+        return rules
+
+
+def _uniform_documents(*documents):
+    """Check that the engine can preserve container types and scalar equality."""
+    mapping = type(documents[0])
+    if mapping not in (dict, NotebookNode) or any(type(doc) is not mapping for doc in documents):
+        return False
+    pending = list(documents)
+    visited = set()
+    while pending:
+        value = pending.pop()
+        kind = type(value)
+        if kind is mapping or kind is list:
+            if id(value) in visited:
+                continue
+            visited.add(id(value))
+            if kind is list:
+                pending.extend(value)
+            else:
+                if (
+                    value.get("output_type") in ("display_data", "execute_result")
+                    and "data" in value
+                    and list(value)[-1] != "data"
+                ):
+                    # The Python notebook differ moves this key to the end in place.
+                    return False
+                pending.extend(value.values())
+        elif kind is float:
+            if isnan(value):
+                return False
+        elif kind not in (str, int, bool, type(None)):
+            return False
+    return True
+
+
+def _custom_diff_has_mappings(entries):
+    pending = list(entries or ())
+    while pending:
+        entry = pending.pop()
+        if entry["op"] == "patch":
+            pending.extend(entry["diff"])
+        else:
+            values = [entry.get("value"), entry.get("valuelist")]
+            while values:
+                value = values.pop()
+                if isinstance(value, dict):
+                    return True
+                if isinstance(value, list):
+                    values.extend(value)
+    return False
+
+
+def _call(name, *args, **kwargs):
+    try:
+        return getattr(_engine, name)(*args, **kwargs)
+    except _engine.EngineError as e:
+        if os.environ.get("NBDIME_ACCEL") == "force":
+            raise
+        logger.debug("nbdime_rs %s failed, using the Python implementation: %s", name, e)
+        return None
+
+
+def _diff_entries(entries, notebook_values):
+    if entries is None:
+        return None
+    diff = []
+    for data in entries:
+        entry = DiffEntry(data)
+        if entry.op == "patch":
+            entry.diff = _diff_entries(entry.diff, notebook_values)
+        elif notebook_values:
+            if "value" in entry:
+                entry.value = from_dict(entry.value)
+            if "valuelist" in entry:
+                entry.valuelist = from_dict(entry.valuelist)
+        diff.append(entry)
+    return diff
+
+
+def diff_notebooks(a, b, config, options):
+    if not enabled():
+        return None
+    ignores = options.ignores(config)
+    if ignores is None or not _uniform_documents(a, b):
+        return None
+    diff = _call("diff_notebooks", a, b, ignores=ignores)
+    return _diff_entries(diff, isinstance(b, NotebookNode))
+
+
+def merge_decisions(base, local, remote, args, config, options):
+    if not enabled():
+        return None
+    ignores = options.ignores(config)
+    if ignores is None or not _uniform_documents(base, local, remote):
+        return None
+    merge_args = None
+    if args:
+        if (
+            type(args) not in (Namespace, SimpleNamespace)
+            or getattr(args, "log_level", "DEBUG") == "DEBUG"
+        ):
+            return None
+        try:
+            merge_args = {
+                name: getattr(args, name)
+                for name in (
+                    "merge_strategy", "input_strategy", "output_strategy", "ignore_transients"
+                )
+            }
+        except AttributeError:
+            return None
+    result = _call("decide_notebook_merge", base, local, remote, merge_args, ignores=ignores)
+    if result is None or any(_custom_diff_has_mappings(d.get("custom_diff")) for d in result):
+        return None
+
+    from .merging.decisions import MergeDecision
+
+    decisions = []
+    for data in result:
+        decision = MergeDecision(data)
+        decision.common_path = tuple(decision.common_path)
+        local_nodes = isinstance(local, NotebookNode)
+        remote_nodes = isinstance(remote, NotebookNode)
+        decision.local_diff = _diff_entries(decision.local_diff, local_nodes)
+        decision.remote_diff = _diff_entries(decision.remote_diff, remote_nodes)
+        if "similar_insert" in decision:
+            decision.similar_insert = _diff_entries(decision.similar_insert, remote_nodes)
+        if "custom_diff" in decision:
+            decision.custom_diff = _diff_entries(decision.custom_diff, False)
+        decisions.append(decision)
+    return decisions
